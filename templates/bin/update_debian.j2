#!/bin/bash


function main() {
  wait_for_ntp; ntp_ret="${?}"
  apt_update; update_ret="${?}"
  apt_upgrade; upgrade_ret="${?}"
  if test 0 -eq "${upgrade_ret}"; then
    apt_full_upgrade; full_upgrade_ret="${?}"
  fi
  check_reboot_required; old_code_ret="${?}"
  apt_autoremove; autoremove_ret="${?}"
  apt_autoclean; autoclean_ret="${?}"
  update_python; python_ret="${?}"
  update_kanboard; kanboard_ret="${?}"

  if ! test 0 -eq "${old_code_ret}"; then 
    fail "Reboot required:  '${old_code_ret}'" $ERR_REBOOT 
  elif ! test 0 -eq "${update_ret}"; then 
    fail "Updates failed:  '${update_ret}'" $ERR_UPDATE 
  elif ! test 0 -eq "${upgrade_ret}"; then 
    fail "Partial upgrades failed:  '${upgrade_ret}'" $ERR_UPGRADE 
  elif ! test 0 -eq "${full_upgrade_ret}"; then 
    fail "Full upgrades failed:  '${full_upgrade_ret}'" $ERR_FULL_UPGRADE 
  elif ! test 0 -eq "${autoremove_ret}"; then 
    fail "Autoremove failed:  '${autoremove_ret}'" $ERR_AUTOREMOVE
  elif ! test 0 -eq "${autoclean_ret}"; then 
    fail "Autoclean failed:  '${autoclean_ret}'" $ERR_AUTOCLEAN 
  elif ! test 0 -eq "${python_ret}"; then
    fail "Python updates failed:  '${python_ret}'" $ERR_PYTHON 
  elif ! test 0 -eq "${kanboard_ret}"; then
    fail "kanboard update failed:  '${kanboard_ret}'" $ERR_KANBOARD 
  elif ! test 0 -eq "${ntp_ret}"; then
    fail "Waiting for NTP synchronization failed:  '${ntp_ret}'" $ERR_NTP
  fi

  succeed
}


function current_time() {
  output "Current time:  $(
    date "+%Y-%m-%d_%H:%M:%S"
  )"
}


function wait_for_ntp() {
  current_time || fail "Failed to note current time."
  output "Waiting for NTP synchronization."

  # ntpwait fails immediately if ntpd is not yet running at all.  crond can
  # start before ntpd, and this script is launched by cron at boot, so this
  # script cannot rely on ntpwait to use those parameters as expected.
  #
  # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1137431

  #ntpwait -n "${ntpwait_try_count}" -s "${ntpwait_try_interval}"; ret="${?}"

  # Manually implement the wait and retry functionality to wait for the NTP
  # service to both start and synchronize.

  ret=1
  attempt=1
  while ! test 0 -eq "${ret}" && test "${attempt}" -le "${ntpwait_try_count}"; do
    # `ntpwait -n 1` returns 1, even if NTP is synchronized.
    # 
    # https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1137430
    #
    # Two tries with zero interval seems fine and seems to fail immediately if
    # not synchronized.  This is stupid, but it works.
    ntpwait -n 2 -s 0; ret="${?}"
    if test 0 -eq "${ret}"; then
      break
    fi
    warn "Waiting for NTP attempt failed:  '${ret}'"
    sleep "${ntpwait_try_interval}"
  done

  output "Waiting for NTP synchronization returned:  '${ret}'"
  return "${ret}"
}


function apt_update() {
  current_time || fail "Failed to note current time."
  output "Apt update starting."
  apt_interface update; ret="${?}"
  output "Apt update returned:  '${ret}'"
  return "${ret}"
}


function apt_upgrade() {
  current_time || fail "Failed to note current time."
  output "Apt upgrade starting."
  DEBIAN_FRONTEND=noninteractive apt_interface -o DPkg::Options::=--force-confdef upgrade -y; ret="${?}"
  output "Apt upgrade returned:  '${ret}'"
  return "${ret}"
}

function apt_full_upgrade() {
  current_time || fail "Failed to note current time."
  output "Apt full upgrade starting."
  DEBIAN_FRONTEND=noninteractive apt_interface -o DPkg::Options::=--force-confdef full-upgrade -y; ret="${?}"
  output "Apt full upgrade returned:  '${ret}'"
}


function check_reboot_required() {
  current_time || fail "Failed to note current time."

  output "Attempting automatic restart of any old code."
  needrestart -qr a

  current_time || fail "Failed to note current time."
  output "Checking for old kernel."
  # needrestart is unable to determine the expected kernel version on buttons
  # (Ubuntu on Jetson Nano), 2023-01-31.  Don't boot loop.
  if needrestart -b | grep -q '^NEEDRESTART-KEXP:'; then
    if ! needrestart -qkp; then
      output "Reboot required (kernel)."
      return $ERR_KERNEL
    fi
  fi

  current_time || fail "Failed to note current time."
  output "Checking for old userland code."
  if ! needrestart -qlp; then
    output "Reboot required (userland)."
    return $ERR_USERLAND
  fi

  output "No reboot required."
}


function apt_autoremove() {
  current_time || fail "Failed to note current time."
  output "Apt autoremove starting."
  output "(Uninstalling old kernels and unneeded dependency packages.)"
  apt_interface autoremove -y; ret="${?}"
  output "Apt autoremove returned:  '${ret}'"
  return "${ret}"
}


function apt_autoclean() {
  current_time || fail "Failed to note current time."
  output "Apt autoclean starting."
  output "(Remove old package files.)"
  apt_interface autoclean -y; ret="${?}"
  output "Apt autoclean returned:  '${ret}'"
  return "${ret}"
}


function update_python() {
  current_time || fail "Failed to note current time."
  if test -e /usr/local/bin/update_python_packages; then
    output "Python updates starting."
    /usr/local/bin/update_python_packages; ret="${?}"
    output "Python updates returned:  '${?}'"
    return "${ret}"
  else
    output "Python updates skipped."
    return 0
  fi
}


function update_kanboard() {
  current_time || fail "Failed to note current time."
  if test -e /usr/local/bin/update_kanboard; then
    output "Kanboard update starging."
    /usr/local/bin/update_kanboard; ret="${?}"
    output "Kanboard update returned:  '${?}'"
    return "${ret}"
  else
    output "Kanboard update skipped."
  fi
}


function apt_interface() {
  # apt-get, aptitude, and apt all take a lot of the same subcommands, but
  # apt-get is recommended for scripting.
  /usr/bin/apt-get "${@}"
}


function succeed() {
  output "Success."
  current_time || fail "Failed to note current time."
}


function fail() {
  error "${1}"
  current_time
  exit ${2:-1}
}


function warn() {
  output "WARNING:  ${1}" >&2
}


function error() {
  output "ERROR:  ${1}" >&2
}


function output() {
  printf '%s\n' "${1}"
}


# Allow ten minutes for NTP to warm up.
# (Defaults are interval=6 and count=100, just short of ten minutes.)
ntpwait_try_interval=30
ntpwait_try_count=21

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ERR_UPDATE="{{ err_update }}"
ERR_UPGRADE="{{ err_upgrade }}"
ERR_FULL_UPGRADE="{{ err_full_upgrade }}"
ERR_KERNEL="{{ err_kernel }}"
ERR_USERLAND="{{ err_userland }}"
ERR_REBOOT="{{ err_reboot }}"
ERR_AUTOCLEAN="{{ err_autoclean }}"
ERR_AUTOREMOVE="{{ err_autoremove }}"
ERR_PYTHON="{{ err_python }}"
ERR_KANBOARD="{{ err_kanboard }}"
ERR_NTP="{{ err_ntp }}"


main
